# Port the Next.js + WebSocket server listens on
PORT=3000

# Shared secret the edge-ai-bridge script sends so /api/edge-inference
# isn't wide open. Change this before any real demo.
EDGE_BRIDGE_TOKEN=devtoken123

# Simulation tick interval in ms (see lib/simulation/engine.ts)
TICK_MS=150

# Optional — enables real LLM parsing for the natural-language task bar
# (lib/llm/taskParser.ts). Unset by default: the feature still works with
# no key, via a deterministic rule-based fallback, so this is opt-in, not
# required. Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
